# Copy to .env for reference only - the app reads real environment variables.
# Locally:  ADMIN_PASSWORD="..." npm start
# On Render: set these in the dashboard (Environment tab), never in Git.

ADMIN_PASSWORD=change-this-to-a-strong-password   # required, 8+ characters
PORT=3000                                         # Render sets this automatically
DATA_DIR=                                         # Render: /var/data (persistent disk mount path). Empty = project folder
TRUST_PROXY=                                      # 1 when behind Nginx. Auto-enabled on Render
